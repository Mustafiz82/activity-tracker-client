{
  "name": "aw-helper",
  "version": "1.0.2",
  "description": "Secure Workspace Tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.6",
    "screenshot-desktop": "^1.15.4"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tracker.app",
    "productName": "aw-helper",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/screenshot-desktop/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "aw helper",
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!dist/*",
      ".env"
    ]
  }
}